            "date": 1778724753144,
            "name": "Commit-0",
            "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>VPN Admin — Users</title>\n<link rel=\"stylesheet\" href=\"/static/style.css\">\n</head>\n<body>\n{{template \"nav\" .}}\n<main>\n  <h2>VPN Users</h2>\n\n  {{if .Error}}\n  <div class=\"alert alert-error\">{{.Error}}</div>\n  {{end}}\n\n  <!-- Add user form -->\n  <details class=\"add-form-toggle\">\n    <summary class=\"btn\">+ Add User</summary>\n    <form method=\"POST\" action=\"/api/v1/users\" class=\"add-form\">\n      <input type=\"hidden\" name=\"_csrf\" value=\"{{.CSRF}}\">\n      <label>Username\n        <input type=\"text\" name=\"username\" placeholder=\"alice\" pattern=\"[a-zA-Z0-9_-]+\" required>\n      </label>\n      <label>SSH Public Key\n        <textarea name=\"public_key\" rows=\"3\" placeholder=\"ssh-ed25519 AAAA...\" required></textarea>\n      </label>\n      <button type=\"submit\" class=\"btn\">Create User</button>\n    </form>\n  </details>\n\n  <!-- User table -->\n  <table class=\"data-table\">\n    <thead>\n      <tr>\n        <th>Username</th>\n        <th>Tun</th>\n        <th>Server IP</th>\n        <th>Client IP</th>\n        <th>Status</th>\n        <th>Created</th>\n        <th>Actions</th>\n      </tr>\n    </thead>\n    <tbody>\n    {{range .Users}}\n    <tr>\n      <td>{{.Username}}</td>\n      <td>tun{{.TunNum}}</td>\n      <td>{{.ServerIP}}</td>\n      <td>{{.ClientIP}}</td>\n      <td><span class=\"status-badge status-{{.TunStatus}}\">{{.TunStatus}}</span></td>\n      <td>{{if not .CreatedAt.IsZero}}{{.CreatedAt.Format \"2006-01-02 15:04\"}}{{else}}—{{end}}</td>\n      <td>\n        <button class=\"btn btn-danger btn-sm\"\n          onclick=\"deleteUser('{{.Username}}', '{{$.CSRF}}')\"\n          title=\"Remove user\">Delete</button>\n      </td>\n    </tr>\n    {{else}}\n    <tr><td colspan=\"7\" class=\"empty\">No VPN users configured.</td></tr>\n    {{end}}\n    </tbody>\n  </table>\n</main>\n\n<script>\nfunction deleteUser(name, csrf) {\n  if (!confirm('Delete user \"' + name + '\"? This cannot be undone.')) return;\n  fetch('/api/v1/users/' + encodeURIComponent(name), {\n    method: 'DELETE',\n    headers: { 'X-CSRF-Token': csrf }\n  }).then(r => {\n    if (r.ok) location.reload();\n    else r.json().then(j => alert('Error: ' + j.error));\n  });\n}\n</script>\n</body>\n</html>\n"
        }
    ]
}